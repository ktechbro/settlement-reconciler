# Export these variables in your shell when running the Go binary directly.
DATABASE_URL=postgres://reconciler:reconciler-local@127.0.0.1:55438/reconciler?sslmode=disable
LISTEN_ADDR=127.0.0.1:8081
ALLOW_FIXTURES=true
TENANT_TOKENS={"local-demo-token-change-me-0001":{"tenant_id":"demo","actor":"developer"}}
# For signed custom-envelope inputs: JSON object keyed by kid, with issuer,
# tenant_id, and base64url-without-padding public_key. Disable fixtures in that mode.
TRUSTED_KEYS={}
# Optional Project 1 importer settings:
INDEXER_URL=http://127.0.0.1:8080
INDEXER_SCOPE=REPLACE_WITH_PROJECT1_SCOPE_HASH
IMPORT_SOURCE_ID=base-indexer
IMPORT_TENANT=demo

# Import native escrow actions alongside the financial transfer stream.
IMPORT_ESCROW_EVENTS=false
